{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",

  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "brain-sdk",
      "changelog-path": "CHANGELOG.md",

      "include-component-in-tag": false,
      "include-v-in-tag": true,

      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,

      "extra-files": [
        "rust/Cargo.toml",
        {
          "type": "toml",
          "path": "rust/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value === 'brain-db-sdk')].version"
        },
        "python/pyproject.toml",
        {
          "type": "json",
          "path": "typescript/package.json",
          "jsonpath": "$.version"
        },
        { "type": "generic", "path": "typescript/src/index.ts" }
      ],

      "changelog-sections": [
        { "type": "fix", "section": "Fixes" },
        { "type": "feat", "section": "Features" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactoring" },
        { "type": "test", "section": "Tests and verification", "hidden": true },
        { "type": "review", "section": "Tests and verification", "hidden": true },
        { "type": "build", "section": "Build and tooling", "hidden": true },
        { "type": "ci", "section": "Build and tooling", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true },
        { "type": "style", "section": "Formatting", "hidden": true }
      ]
    }
  }
}
